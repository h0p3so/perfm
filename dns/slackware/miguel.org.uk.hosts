;
; /etc/DNS/miguel.org.uk.hosts
; PRIMARY zone file -- edit here, then BUMP THE SERIAL.
;
$TTL 86400
@       IN      SOA     ns1.miguel.org.uk. root.miguel.org.uk. (
                        2026092301      ; Serial  yyyyMMddxx
                        3600            ; Refresh
                        900             ; Retry
                        604800          ; Expire
                        86400 )         ; Negative cache TTL

; Name servers for this zone
@                       IN      NS      ns1.miguel.org.uk.
@                       IN      NS      ns2.miguel.org.uk.

; Mail server (no mail service yet -- required by a later lab)
;@                      IN      MX 10   mail.miguel.org.uk.

; --- 3 hosts with IPv4 addresses (A) ---
ns1                     IN      A       192.168.2.9     ; this server (Slackware)
ns2                     IN      A       192.168.2.11    ; secondary  (Solaris)
app1                    IN      A       192.168.2.21    ; reserved for a future service

; --- 2 hosts with IPv6 addresses (AAAA) ---
ns1                     IN      AAAA    fd00:2::9
file1                   IN      AAAA    fd00:2::31

; --- 3 aliases (CNAME): two onto IPv4 hosts, one onto an IPv6 host ---
dns                     IN      CNAME   ns1             ; -> IPv4 host
www                     IN      CNAME   app1            ; -> IPv4 host
files                   IN      CNAME   file1           ; -> IPv6 host

localhost               IN      A       127.0.0.1
