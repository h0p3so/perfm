;
; /etc/DNS/diego.com.it.hosts
; PRIMARY zone file -- edit here, then BUMP THE SERIAL.
;
$TTL 86400
@       IN      SOA     ns1.diego.com.it. root.diego.com.it. (
                        2026092301      ; Serial  yyyyMMddxx
                        3600            ; Refresh
                        900             ; Retry
                        604800          ; Expire
                        86400 )         ; Negative cache TTL

; Name servers for this zone
@                       IN      NS      ns1.diego.com.it.
@                       IN      NS      ns2.diego.com.it.

; Mail server (no mail service yet -- required by a later lab)
;@                      IN      MX 10   mail.diego.com.it.

; --- 3 hosts with IPv4 addresses (A) ---
ns1                     IN      A       192.168.2.11    ; this server (Solaris)
ns2                     IN      A       192.168.2.9     ; secondary  (Slackware)
web1                    IN      A       192.168.2.20    ; reserved for a future service

; --- 2 hosts with IPv6 addresses (AAAA) ---
ns1                     IN      AAAA    fd00:2::11
db1                     IN      AAAA    fd00:2::30

; --- 3 aliases (CNAME): two onto IPv4 hosts, one onto an IPv6 host ---
dns                     IN      CNAME   ns1             ; -> IPv4 host
www                     IN      CNAME   web1            ; -> IPv4 host
data                    IN      CNAME   db1             ; -> IPv6 host

localhost               IN      A       127.0.0.1
